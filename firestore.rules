rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Rule tables (teacher-owned parameter validation rules)
    match /ruleTables/{id} {
      allow read:   if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }

    // Lessons (teacher-owned)
    match /lessons/{id} {
      // Published lessons readable by any authenticated user (students join by code)
      allow read:   if resource.data.published == true || request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }

    // Attempts (student-owned; teacher reads via lesson ownership)
    match /attempts/{id} {
      allow read:   if request.auth != null
                    && (request.auth.uid == resource.data.studentUid
                        || request.auth.uid == get(/databases/$(database)/documents/lessons/$(resource.data.lessonId)).data.ownerId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentUid;
      allow update: if request.auth != null && request.auth.uid == resource.data.studentUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.studentUid;
    }

    // Media library metadata (owner-scoped GLB uploads)
    match /media/{mediaId} {
      allow read, write, delete: if request.auth != null
                                 && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId;
    }
  }
}
