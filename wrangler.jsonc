{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heitirpottar",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
